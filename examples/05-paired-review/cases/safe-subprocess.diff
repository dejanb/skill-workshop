+import subprocess
+
+
+def git_status() -> str:
+    """Read status with fixed arguments and no shell."""
+    result = subprocess.run(
+        ["git", "status", "--short"],
+        capture_output=True, text=True, check=True,
+    )
+    return result.stdout
