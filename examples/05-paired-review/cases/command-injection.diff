+import subprocess
+
+
+def run_user_command(user_input: str) -> str:
+    """Run a command received from an HTTP request body."""
+    result = subprocess.run(
+        user_input, shell=True, capture_output=True, text=True, check=True
+    )
+    return result.stdout
